general {
    colors = true
    interval = 5
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery 0"
order += "cpu_temperature 0"
order += "memory"
order += "volume master"
order += "disk /"
order += "time"

wireless _first_ {
    format_up = "  %quality at %essid"
    format_down = "睊 Disconnected"
}

ethernet _first_ {
    format_up = "󰈀 %ip"
    format_down = ""
}

battery 0 {
    format = " %percentage %remaining"
    format_down = "Battery?"
    path = "/sys/class/power_supply/BAT0"
}

cpu_temperature 0 {
    format = " %degrees °C"
    path = "/sys/class/thermal/thermal_zone0/temp"
}

memory {
    format = "󰍛 %used / %total"
    threshold_degraded = "1G"
    format_degraded = "MEMORY CRIT"
}

volume master {
    format = " %volume"
    format_muted = " Muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

disk "/" {
    format = " %avail"
}

time {
    format = "%Y-%m-%d %H:%M:%S"
}
